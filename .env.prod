# Production environment override
APP_ENV=production

# Embedding provider selection: openai | dashscope | local
EMBEDDING_PROVIDER=local

# OpenAI-compatible API configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=qwen-flash

# DashScope configuration
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# Local sentence-transformers configuration
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_DEVICE=cpu

# Qdrant configuration
QDRANT_URL=http://111.230.197.153:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_VECTOR_SIZE=384

# Chunking configuration
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# Flask configuration
SECRET_KEY=change-me-in-production
DEBUG=false